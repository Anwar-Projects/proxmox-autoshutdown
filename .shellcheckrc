# ShellCheck configuration file
# https://github.com/koalaman/shellcheck/wiki/Directive

# Shell dialect to use
shell=bash

# Disable specific checks that conflict with the project style
# SC2154: var is referenced but not assigned (we use ENV defaults)
disable=SC2154

# SC2034: var appears unused (used as ENV or sourced)
disable=SC2034

# SC1090: Can't follow non-constant source
disable=SC1090

# SC1091: Not following: (sourced scripts)
disable=SC1091

# SC2250: Prefer putting braces around variable references (style preference)
disable=SC2250

# SC2312: Consider invoking command separately (info only)
disable=SC2312

# External sources are OK
external-sources=true

# Severity level (error, warning, info, style)
severity=warning
