</html>
EOF

  local sz
  sz="$(wc -c <"$HTML_REPORT" 2>/dev/null || echo "unknown")"
  log "INFO" "HTML report generated at $HTML_REPORT (${sz} bytes)"
}

###############################################################################
# Email send
###############################################################################
send_html_email() {
  if (( DRY_RUN )); then
    log "INFO" "DRY-RUN: Skipping email send"
    return 0
  fi

  if ! command -v sendmail >/dev/null 2>&1; then
    log "ERROR" "sendmail not found. Install msmtp-mta or postfix."
    return 1
  fi

  local subject="${MAIL_SUBJECT_PREFIX} - $(hostname) - $(date '+%Y-%m-%d %H:%M')"
  log "INFO" "Sending HTML report to ${MAIL_TO}"

  {
    echo "To: ${MAIL_TO}"
    echo "From: ${MAIL_FROM}"
    echo "Subject: ${subject}"
    echo "MIME-Version: 1.0"
    echo "Content-Type: text/html; charset=UTF-8"
    echo "Content-Transfer-Encoding: 8bit"
    echo
    cat "$HTML_REPORT"
  } | sendmail -t >>"$LOG_FILE" 2>&1

  local rc=$?
  if (( rc != 0 )); then
    log "ERROR" "sendmail returned rc=$rc"
    return "$rc"
  fi

  log "INFO" "Email handed to sendmail successfully."
}

###############################################################################
# Main
###############################################################################
log "INFO" "=== Starting Proxmox Maintenance (dry-run=${DRY_RUN}) ==="
log "INFO" "Effective settings: MAIL_TO=${MAIL_TO} POWER_OFF_NODE=${POWER_OFF_NODE}"

shutdown_vms

log "INFO" "Starting apt maintenance."
run_cmd "apt update"       apt update -y
run_cmd "apt dist-upgrade" apt dist-upgrade -y
run_cmd "apt autoremove"   apt autoremove -y
run_cmd "apt clean"        apt clean

wait_for_pbs_tasks

log "INFO" "Proceeding to report generation + email."
generate_html_report
send_html_email

log "INFO" "Preparing to shutdown node. POWER_OFF_NODE=${POWER_OFF_NODE}"

if (( DRY_RUN )); then
  log "INFO" "DRY-RUN: Skipping shutdown"
  log "INFO" "DONE"
  exit 0
fi

date +%s > "$LAST_SHUTDOWN_FILE"

if (( POWER_OFF_NODE == 1 )); then
  log "INFO" "Initiating systemctl poweroff."
  systemctl poweroff
else
  log "INFO" "POWER_OFF_NODE=0, not powering off."
  log "INFO" "DONE"
fi
