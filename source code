#!/bin/bash
###############################################################################
# Proxmox maintenance + health report (EMAIL BEFORE SHUTDOWN)
# - Shuts down running VMs
# - Runs apt maintenance
# - Waits for PBS tasks
# - Generates HTML report (black background, lime text, Calibri)
# - Sends HTML report using local sendmail interface (msmtp-mta or postfix)
# - Optionally powers off node
###############################################################################

set -Eeuo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

###############################################################################
# Configuration (ENV overrides supported)
###############################################################################
LOG_FILE="${LOG_FILE:-/var/log/proxmox_maintenance.log}"
STATE_DIR="${STATE_DIR:-/var/lib/proxmox_maintenance}"
LAST_SHUTDOWN_FILE="$STATE_DIR/last_shutdown_timestamp"
HTML_REPORT="${HTML_REPORT:-/tmp/proxmox_dashboard_report.html}"

# Email
MAIL_TO="${MAIL_TO:-anwarspamemails@gmail.com}"
MAIL_FROM="${MAIL_FROM:-proxmox@$(hostname -f 2>/dev/null || hostname)}"
MAIL_SUBJECT_PREFIX="${MAIL_SUBJECT_PREFIX:-Proxmox Health + Shutdown Report}"

# Behavior
POWER_OFF_NODE="${POWER_OFF_NODE:-1}"        # 1=yes, 0=no (env override supported)
VM_SHUTDOWN_TIMEOUT="${VM_SHUTDOWN_TIMEOUT:-60}"
VM_GLOBAL_WAIT="${VM_GLOBAL_WAIT:-600}"

PBS_SAFETY_WAIT="${PBS_SAFETY_WAIT:-900}"
PBS_STABLE_CHECKS="${PBS_STABLE_CHECKS:-10}"
PBS_INTERVAL="${PBS_INTERVAL:-5}"

# DRY_RUN: 1 via env or --dry-run argument
DRY_RUN="${DRY_RUN:-0}"
if [[ "${1:-}" == "--dry-run" || "$DRY_RUN" == "1" ]]; then
  DRY_RUN=1
else
  DRY_RUN=0
fi

mkdir -p "$STATE_DIR"

###############################################################################
# Logging
###############################################################################
log() {
  local level="$1"; shift
  local msg="$*"
  local ts
  ts="$(date '+%Y-%m-%d %H:%M:%S')"
  echo "[$ts] [$level] $msg" | tee -a "$LOG_FILE"
}

###############################################################################
# Error trap: if anything fails, still generate + send report (best effort)
###############################################################################
on_error() {
  local rc=$?
  log "ERROR" "Script failed (rc=$rc) at line ${BASH_LINENO[0]}."
  set +e
  generate_html_report
  send_html_email
  set -e
  exit "$rc"
}
trap on_error ERR

###############################################################################
# Uptime / Downtime tracking
###############################################################################
get_boot_time_epoch() {
  local bt
  bt="$(who -b | awk '{print $3" "$4}')"
  date -d "$bt" +%s 2>/dev/null || echo 0
}

format_duration() {
  local seconds="$1"
  if (( seconds <= 0 )); then echo "n/a"; return; fi
  local days=$((seconds/86400))
  local hours=$(((seconds%86400)/3600))
  local mins=$(((seconds%3600)/60))
  local secs=$((seconds%60))
  local out=""
  (( days > 0 )) && out+="${days}d "
  (( hours > 0 )) && out+="${hours}h "
  (( mins > 0 )) && out+="${mins}m "
  (( secs > 0 )) && out+="${secs}s"
  echo "${out:-0s}"
}

compute_downtime_info() {
  local boot_epoch last_shutdown_epoch downtime
  boot_epoch="$(get_boot_time_epoch)"
  if [[ -f "$LAST_SHUTDOWN_FILE" ]]; then
    last_shutdown_epoch="$(cat "$LAST_SHUTDOWN_FILE" 2>/dev/null || echo 0)"
  else
    last_shutdown_epoch=0
  fi

  if (( last_shutdown_epoch > 0 && boot_epoch > last_shutdown_epoch )); then
    downtime=$(( boot_epoch - last_shutdown_epoch ))
  else
    downtime=0
  fi
  DOWNTIME_HUMAN="$(format_duration "$downtime")"
}

BOOT_TIME_HUMAN="$(who -b | awk '{$1=$1; print substr($0,index($0,$3))}')"
UPTIME_HUMAN="$(uptime -p 2>/dev/null || uptime)"
compute_downtime_info

###############################################################################
# Command runner (logs stdout/stderr to LOG_FILE)
###############################################################################
run_cmd() {
  local desc="$1"; shift
  local cmd=("$@")
  log "INFO" "$desc: ${cmd[*]}"

  if (( DRY_RUN )); then
    log "INFO" "DRY-RUN: skipped execution"
    return 0
  fi

  "${cmd[@]}" >>"$LOG_FILE" 2>&1
}

###############################################################################
# Health collection
###############################################################################
collect_system_health() {
  HOSTNAME="$(hostname)"
  NOW_HUMAN="$(date)"
  LOAD_AVG="$(cat /proc/loadavg 2>/dev/null || echo "n/a")"
  MEM_INFO="$(free -h 2>/dev/null || echo "n/a")"
  DISK_ROOT="$(df -h / 2>/dev/null || echo "n/a")"

  SMART_INFO=""
  if command -v smartctl >/dev/null 2>&1; then
    local disks
    disks="$(ls /dev/sd? /dev/nvme?n? 2>/dev/null || true)"
    for d in $disks; do
      [[ -b "$d" ]] || continue
      SMART_INFO+="<h4>$d</h4><pre>$(smartctl -H "$d" 2>&1)</pre>"
    done
    [[ -z "$SMART_INFO" ]] && SMART_INFO="<p>No SMART-capable disks found.</p>"
  else
    SMART_INFO="<p>smartctl not installed.</p>"
  fi

  NET_INFO="<pre>$(ip -brief addr 2>/dev/null || ip addr 2>/dev/null)</pre>"
  NET_INFO+="<pre>$(ss -tuna 2>/dev/null || netstat -tuna 2>/dev/null)</pre>"
}

###############################################################################
# VM info (hardened: MUST NOT FAIL under set -e)
###############################################################################
collect_vm_info() {
  VM_TABLE_ROWS=""

  # If qm binary isn't present/available, do not fail.
  if ! command -v qm >/dev/null 2>&1; then
    VM_TABLE_ROWS="<tr><td colspan=3>qm not available</td></tr>"
    return 0
  fi

  # qm list may fail transiently; never abort.
  local qm_out
  qm_out="$(qm list 2>/dev/null || true)"

  if [[ -z "$qm_out" ]]; then
    VM_TABLE_ROWS="<tr><td colspan=3>No VM data available (qm list returned empty or failed)</td></tr>"
    return 0
  fi

  # Build rows safely; any per-VM status lookup may fail, so guard it.
  while read -r vmid name status rest; do
    [[ "$vmid" == "VMID" ]] && continue
    [[ -z "$vmid" ]] && continue
    [[ ! "$vmid" =~ ^[0-9]+$ ]] && continue

    local qstatus
    qstatus="$(qm status "$vmid" 2>/dev/null | awk '{print $2}' || true)"
    [[ -z "$qstatus" ]] && qstatus="${status:-unknown}"

    VM_TABLE_ROWS+="<tr><td>$vmid</td><td>${name:-n/a}</td><td>${qstatus}</td></tr>"
  done < <(printf "%s\n" "$qm_out")

  [[ -z "$VM_TABLE_ROWS" ]] && VM_TABLE_ROWS="<tr><td colspan=3>No VMs found</td></tr>"

  return 0
}

###############################################################################
# PBS backup summary
###############################################################################
collect_pbs_summary() {
  if ! command -v proxmox-backup-manager >/dev/null 2>&1; then
    PBS_TABLE_ROWS="<tr><td colspan=5>PBS not installed</td></tr>"
    return 0
  fi

  PBS_TABLE_ROWS=""

  if command -v jq >/dev/null 2>&1; then
    local json
    json="$(proxmox-backup-manager task list --output-format json 2>/dev/null || echo "[]")"

    mapfile -t lines < <(echo "$json" | jq -r \
      '.[] | "\(.up_id)|\(.type)|\(.starttime)|\(.endtime // "")|\(.state)"' \
      | tail -n 10)

    if ((${#lines[@]} == 0)); then
      PBS_TABLE_ROWS="<tr><td colspan=5>No PBS tasks found</td></tr>"
      return 0
    fi

    for l in "${lines[@]}"; do
      IFS="|" read -r up_id type start end state <<<"$l"
      PBS_TABLE_ROWS+="<tr><td>$up_id</td><td>$type</td><td>$start</td><td>${end:-n/a}</td><td>$state</td></tr>"
    done
  else
    PBS_TABLE_ROWS="<tr><td colspan=5><pre>$(proxmox-backup-manager task list 2>/dev/null || echo "n/a")</pre></td></tr>"
  fi

  return 0
}

###############################################################################
# VM shutdown
###############################################################################
shutdown_vms() {
  local running_vms=()
  local vmid status

  while read -r vmid; do
    [[ -z "$vmid" || ! "$vmid" =~ ^[0-9]+$ ]] && continue
    status="$(qm status "$vmid" 2>/dev/null | awk '{print $2}' || true)"
    [[ "$status" == "running" ]] && running_vms+=("$vmid")
  done < <(qm list 2>/dev/null | awk 'NR>1 {print $1}' || true)

  if (( ${#running_vms[@]} == 0 )); then
    log "INFO" "No running VMs detected."
    return 0
  fi

  log "INFO" "Running VMs: ${running_vms[*]}"
  for vmid in "${running_vms[@]}"; do
    run_cmd "Requesting shutdown for VM $vmid" qm shutdown "$vmid" --timeout "$VM_SHUTDOWN_TIMEOUT"
  done

  local waited=0
  while (( waited < VM_GLOBAL_WAIT )); do
    local still_running=()
    for vmid in "${running_vms[@]}"; do
      status="$(qm status "$vmid" 2>/dev/null | awk '{print $2}' || true)"
      [[ "$status" == "running" ]] && still_running+=("$vmid")
    done

    if (( ${#still_running[@]} == 0 )); then
      log "INFO" "All VMs stopped."
      return 0
    fi

    log "INFO" "Still running: ${still_running[*]} (waited ${waited}/${VM_GLOBAL_WAIT}s)"
    sleep 10
    waited=$(( waited + 10 ))
  done

  log "WARNING" "Some VMs did not shut down in time."
  return 0
}

###############################################################################
# PBS wait
###############################################################################
pbs_tasks_running() {
  if ! command -v proxmox-backup-manager >/dev/null 2>&1; then return 1; fi
  if command -v jq >/dev/null 2>&1; then
    proxmox-backup-manager task list --output-format json 2>/dev/null \
      | jq -e '.[] | select(.state == "running")' >/dev/null 2>&1
    return $?
  fi
  proxmox-backup-manager task list 2>/dev/null | awk 'NR>1' | grep -qi "running"
}

wait_for_pbs_tasks() {
  log "INFO" "Checking for PBS tasks..."
  local stable=0
  local elapsed=0

  while (( elapsed < PBS_SAFETY_WAIT )); do
    if pbs_tasks_running; then
      stable=0
      log "INFO" "PBS tasks running. Waiting..."
    else
      stable=$((stable + 1))
      log "INFO" "No PBS tasks running (${stable}/${PBS_STABLE_CHECKS})"
      (( stable >= PBS_STABLE_CHECKS )) && return 0
    fi
    sleep "$PBS_INTERVAL"
    elapsed=$((elapsed + PBS_INTERVAL))
  done

  log "WARNING" "PBS wait timeout exceeded."
  return 0
}

###############################################################################
# Report generation (Black background, Lime text, Calibri)
###############################################################################
generate_html_report() {
  collect_system_health
  collect_vm_info
  collect_pbs_summary

  local LOG_SNIPPET
  LOG_SNIPPET="$(tail -n 200 "$LOG_FILE" 2>/dev/null || echo "No log data available.")"

  cat > "$HTML_REPORT" <<EOF
<!DOCTYPE html>
<html>
<head>
<meta charset='UTF-8'>
<title>Proxmox Maintenance Report</title>
<style>
  body {
    background:#000000 !important;
    color:#00ff00 !important;
    font-family: Calibri, "Segoe UI", Arial, sans-serif !important;
    padding:20px;
  }
  .container {
    max-width:1000px;
    margin:auto;
    background:#000000 !important;
    padding:20px;
    border:1px solid #00ff00;
  }
  .section {
    background:#000000 !important;
    padding:15px;
    margin-bottom:20px;
    border:1px solid #00ff00;
  }
  h1,h2,h3,h4,p,b,span,div { color:#00ff00 !important; margin-top:0; }
  a { color:#00ff00 !important; }

  table { width:100%; border-collapse:collapse; margin-top:10px; }
  table, thead, tbody, tr, th, td {
    color:#00ff00 !important;
    background:#000000 !important;
    border:1px solid #00ff00 !important;
  }
  table * { color:#00ff00 !important; }
  th, td { padding:6px; text-align:left; }

  pre {
    background:#000000 !important;
    color:#00ff00 !important;
    border:1px solid #00ff00;
    padding:10px;
    overflow-x:auto;
    white-space:pre-wrap;
    word-wrap:break-word;
  }
</style>
</head>
<body>
<div class='container'>
<h1>Proxmox Health + Shutdown Report</h1>
<p><b>Node:</b> $HOSTNAME<br>
<b>Generated:</b> $NOW_HUMAN</p>

<div class='section'>
<h2>Node Overview</h2>
<p><b>Uptime:</b> $UPTIME_HUMAN<br>
<b>Last Boot:</b> $BOOT_TIME_HUMAN<br>
<b>Previous Downtime:</b> $DOWNTIME_HUMAN<br>
<b>Load Average:</b> $LOAD_AVG</p>
</div>

<div class='section'>
<h2>System Resources</h2>
<h3>Disk Usage (/)</h3><pre>$DISK_ROOT</pre>
<h3>Memory Usage</h3><pre>$MEM_INFO</pre>
</div>

<div class='section'>
<h2>VMs</h2>
<table>
<tr><th>VMID</th><th>Name</th><th>Status</th></tr>
