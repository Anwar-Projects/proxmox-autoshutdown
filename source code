$PBS_TABLE_ROWS
</table>
</div>

<div class='section'>
<h2>SMART Disk Health</h2>
$SMART_INFO
</div>

<div class='section'>
<h2>Network</h2>
$NET_INFO
</div>

<div class='section'>
<h2>Maintenance Log (last 200 lines)</h2>
<pre>$LOG_SNIPPET</pre>
</div>

</div>
